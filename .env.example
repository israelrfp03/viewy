SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TMDB_ACCESS_TOKEN=change-me
GEMINI_API_KEY=change-me

# --- Solo producción (Vercel) ---
# En local, deja estas dos vacías o coméntalas: sin DATABASE_URL la app usa
# SQLite automáticamente, y sin CSRF_TRUSTED_ORIGINS no hace falta porque
# localhost ya funciona por defecto.
#
# DATABASE_URL: connection string de Supabase — usa el TRANSACTION POOLER (puerto 6543).
# Para aplicar migraciones a mano desde tu PC usa el SESSION POOLER (puerto 5432).
# DATABASE_URL=postgresql://usuario:password@host-pooler.supabase.com:6543/postgres
#
# CSRF_TRUSTED_ORIGINS: dominio público con esquema https:// incluido.
# CSRF_TRUSTED_ORIGINS=https://viewy.vercel.app
